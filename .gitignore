# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit local credentials.
.env
.env.*
!.env.example

# Optional API-baked Docker variant — LOCAL-ONLY (secret-bearing image; never committed).
# Keep local-only Docker variants out of Git; GitHub keeps only the safe Dockerfile.
Dockerfile.api
Dockerfile.api.local

# Local model weights / HF cache / temp (kept outside git; ignore if placed here)
models/
.hf-cache/
.tmp/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local prediction outputs (keep the dir via .gitkeep, ignore generated files).
# EXCEPTIONS: the required final-package artifacts are tracked so a git clone/package can
# build & run without regenerating them — the winning v11 submission (production default)
# and the v10 fallback. The runtime export (pred.csv) and experimental candidates stay ignored.
output/*
!output/.gitkeep
# Official tracked frozen artifacts (current best + previous bests + fallback):
!output/pred_v13_multilayer_candidate_api30_from_v12b.csv
!output/pred_v12b_permutation_candidate_api30.csv
!output/pred_v11_independent_rerun1.csv
!output/pred_v10_full_production_user_run.csv
!output/pred_v8_clean_generalized_from_v7.csv

# Data dropped in by the harness at runtime (keep the dir, ignore contents)
data/*
!data/.gitkeep

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Local model weights - never commit
models/*
!models/.gitkeep
!models/README.md

scratch/*
# BTC Docker smoke / local run scratch dirs (never committed)
btc_data/
btc_output/
btc_contract_smoke/
docker_compat_smoke/
