# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit API keys (OPENROUTER_API_KEY etc.)
.env
.env.*
!.env.example

# Local model weights / HF cache / temp (kept outside git; ignore if placed here)
models/
.hf-cache/
.tmp/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local prediction outputs (keep the dir via .gitkeep, ignore generated files).
# EXCEPTIONS: the required final-package artifacts are tracked so a git clone/package can
# build & run without regenerating them — the winning v11 submission (production default)
# and the v10 fallback. The runtime export (pred.csv) and experimental candidates stay ignored.
outputs/*
!outputs/.gitkeep
!outputs/pred_v11_independent_rerun1.csv
!outputs/pred_v10_full_production_user_run.csv

# Data dropped in by the harness at runtime (keep the dir, ignore contents)
data/*
!data/.gitkeep

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Local model weights - never commit
models/*
!models/.gitkeep
!models/README.md

scratch/*