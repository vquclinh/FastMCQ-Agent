# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit API keys (OPENROUTER_API_KEY etc.)
.env
.env.*
!.env.example

# Local model weights / HF cache / temp (kept outside git; ignore if placed here)
models/
.hf-cache/
.tmp/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local prediction outputs (keep the dir via .gitkeep, ignore generated files)
outputs/*
!outputs/.gitkeep

# Data dropped in by the harness at runtime (keep the dir, ignore contents)
data/*
!data/.gitkeep

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Local model weights - never commit
models/*
!models/.gitkeep
!models/README.md